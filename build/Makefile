.PHONY : src/models/Person.cpp.s

tests/test_core.obj: tests/test_core.cpp.obj
.PHONY : tests/test_core.obj

# target to build an object file
tests/test_core.cpp.obj:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\TestCore.dir\build.make CMakeFiles/TestCore.dir/tests/test_core.cpp.obj
.PHONY : tests/test_core.cpp.obj

tests/test_core.i: tests/test_core.cpp.i
.PHONY : tests/test_core.i

# target to preprocess a source file
tests/test_core.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\TestCore.dir\build.make CMakeFiles/TestCore.dir/tests/test_core.cpp.i
.PHONY : tests/test_core.cpp.i

tests/test_core.s: tests/test_core.cpp.s
.PHONY : tests/test_core.s

# target to generate assembly for a file
tests/test_core.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\TestCore.dir\build.make CMakeFiles/TestCore.dir/tests/test_core.cpp.s
.PHONY : tests/test_core.cpp.s

